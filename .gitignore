# Build output. Installers belong on the Releases page, not in the tree.
/build/
/dist/
/out/
# Generated from svrspec.__version__ by installer/setup_cxfreeze.py, so that the
# Inno Setup script never carries a version of its own to go stale.
/installer/version.iss
*.egg-info/
__pycache__/
*.py[cod]

# Environments
.venv/
venv/

# Test + tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Model weights are large and are never part of this repo: the simulator is
# analytical and does not need them.
*.gguf
*.safetensors

# Internal dispatch notes from the parallel catalogue-collection sessions.
/.briefs/

# OS noise
Thumbs.db
.DS_Store
desktop.ini
